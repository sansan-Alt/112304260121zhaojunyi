# 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 数据路径配置
DATA_DIR=./data
TRAIN_FILE=labeledTrainData.tsv
TEST_FILE=testData.tsv
UNLABELED_FILE=unlabeledTrainData.tsv

# 模型配置
VECTORIZER_TYPE=tfidf
MAX_FEATURES=5000
VECTOR_SIZE=300

# 训练配置
EPOCHS=10
CV_FOLDS=5

# 输出配置
RESULTS_DIR=./results
MODEL_DIR=./models

# 日志配置
LOG_LEVEL=INFO